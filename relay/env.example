# /etc/vellia-relay.env
RELAY_SECRET=замените-на-длинную-случайную-строку
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_KEY_PATH=/etc/vellia/AuthKey.p8
APPLE_BUNDLE_ID=es.verkvest.velliamail
APNS_ENV=production
BIND=127.0.0.1
PORT=8787

# /etc/vellia-watch.env
# RELAY_URL=http://127.0.0.1:8787
# RELAY_SECRET=тот-же-секрет
# WATCH_EVERY_SECONDS=60
# Один ящик через переменные:
# IMAP_HOST=imap.mail.ru
# IMAP_PORT=993
# IMAP_USER=hotel@mail.ru
# IMAP_PASSWORD=пароль-приложения
# Несколько ящиков: ACCOUNTS_FILE=/etc/vellia/accounts.json
# Формат файла: [{ "label": "mail", "host": "imap.mail.ru", "port": 993, "username": "a@mail.ru", "password": "..." }]
